{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPath": "/auth/google/callback",
    "queryParameters": {
      "code": {
        "matches": ".+"
      },
      "state": {
        "matches": ".+"
      }
    }
  },
  "response": {
    "status": 302,
    "headers": {
      "Access-Control-Allow-Origin": "http://localhost:3000",
      "Access-Control-Allow-Credentials": "true",
      "Location": "http://localhost:3000/mypage",
      "Set-Cookie": "app_session=wiremock-session; Path=/; Max-Age=86400; HttpOnly; SameSite=Lax"
    }
  }
}
